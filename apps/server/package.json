{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@loopkit/auth": "workspace:*",
    "@loopkit/ai": "workspace:*",
    "@loopkit/core": "workspace:*",
    "@loopkit/db": "workspace:*",
    "@loopkit/email": "workspace:*",
    "@loopkit/engine": "workspace:*",
    "@loopkit/env": "workspace:*",
    "@loopkit/journey": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.12.32",
    "pg": "^8.22.0",
    "ts-workflow-engine-lite": "^3.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loopkit/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
